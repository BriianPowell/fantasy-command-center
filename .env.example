# Copy this file to .env (already gitignored) and fill in real values.
# Never commit real API keys.

# FantasyPros public API key (free tier: personal, non-commercial use).
# Request one at https://secure.fantasypros.com/api-keys/request/
# Used only by offline scripts under models/player-ranking/, never by the web app.
FANTASYPROS_API_KEY=

# Folder holding the manually downloaded FantasyPros CSV exports, one
# subfolder per season (e.g. ".../NFL Data/2025/FantasyPros_..._QB.csv").
# Leave blank to auto-detect a single ~/Library/CloudStorage/Nextcloud-*
# account containing an "NFL Data" folder, or pass --source on the CLI.
FANTASYPROS_DATA_DIR=
